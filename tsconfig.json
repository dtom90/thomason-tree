{
  "compilerOptions": {
    "target": "es2015",
    "module": "esnext",
    "allowJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "$lib": ["./app/thomason/src/lib"],
      "$lib/*": ["./app/thomason/src/lib/*"]
    }
  },
  "include": ["src"]
}
