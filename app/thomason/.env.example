VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Google Picker (same Cloud project as Supabase Google OAuth). Enable Picker + Drive APIs.
VITE_GOOGLE_API_KEY=
# Required for drive.file uploads: GCP project number (Console Home → Project number)
VITE_GOOGLE_APP_ID=
